# ==========================================
# Frontend Environment Settings
# ==========================================
# Set your backend URL:
VITE_BACKEND_URL=http://localhost:8000

# ==========================================
# Google OAuth 2.0 (Web Client ID)
# ==========================================
# Get this from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
# Make sure to add http://localhost:3000 (or your port) and http://localhost:5173 to Authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
