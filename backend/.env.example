# ==========================================
# NVIDIA NIM API Settings
# ==========================================
# Get your free key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v1

# ==========================================
# Vector Database (Qdrant)
# ==========================================
# Leave QDRANT_URL empty to use built-in embedded Qdrant on Render disk (100% free, no local PC needed)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=pmis_internships_120_kb

# ==========================================
# Cloudinary (Optional - for persistent CDN resume hosting)
# ==========================================
# If omitted, resumes are saved locally to backend/static/resumes/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# MongoDB Database
# ==========================================
MONGODB_URI=mongodb://localhost:27017/pmis_db
MONGODB_DB_NAME=pmis_db

# ==========================================
# JWT Authentication & Tokens
# ==========================================
JWT_SECRET_KEY=pmis_jwt_secret_key_super_secure_2026_dev_prod
JWT_REFRESH_SECRET_KEY=pmis_jwt_refresh_secret_key_super_secure_2026_dev_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==========================================
# Google OAuth 2.0 (Optional - for real Google sign-in)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# Server Settings
# ==========================================
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
ENVIRONMENT=production
