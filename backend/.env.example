# ==========================================
# NVIDIA NIM API Settings
# ==========================================
# Get your free key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Models
# Primary LLM requested:
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Fallback models (if needed):
# NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct

# Embedding model:
NVIDIA_EMBEDDING_MODEL=baai/bge-m3
# Alternative: nvidia/nemotron-3.5-embed-1b, nvidia/nv-embedqa-e5-v5

# ==========================================
# Vector Database (Qdrant)
# ==========================================
# For 100% Free Cloud Hosting on Render (NO local PC required!):
# 1. OPTION A (Easiest - Embedded): Leave QDRANT_URL empty!
#    The backend will use built-in embedded Qdrant inside Render's disk/memory automatically.
# 2. OPTION B (Qdrant Cloud Free Tier):
#    Sign up at https://cloud.qdrant.io, create a free 1GB cluster, and put URL & API key here:
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=iit_internships_knowledge_base

# ==========================================
# Server Settings
# ==========================================
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
ENVIRONMENT=production
